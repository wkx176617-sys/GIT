#!/usr/bin/env bash
set -Eeuo pipefail

readonly STATE_ROOT="${SOCKS_SAFETY_ROOT:-/var/lib/gost-socks-safety}"
readonly SNAPSHOT_ROOT="$STATE_ROOT/snapshots"
readonly INCIDENT_FILE="$STATE_ROOT/incidents.tsv"
readonly CONFIG_DIR="${SOCKS_CONFIG_DIR:-/etc/gost-socks}"
readonly BINARY_DIR="${SOCKS_BINARY_DIR:-/usr/local/lib/gost-socks}"
readonly SERVICE_FILE="${SOCKS_SERVICE_FILE:-/etc/systemd/system/gost-socks.service}"
readonly TOOLS_DIR="${SOCKS_TOOLS_DIR:-/usr/local/sbin}"
readonly SERVICE="gost-socks.service"
readonly -a TOOL_NAMES=(
  socksctl
  socks-uninstall
  socks-doctor
  socks-safety
  socks-refresh-ip
  socks-upgrade
  bbrctl
)

usage() {
  cat <<'EOF'
内部安全工具：socks-safety <snapshot|promote|verify|restore|snapshots|incident|incidents> [参数]
请优先使用 socksctl doctor、socksctl heal、socksctl recover 和 socksctl incidents。
EOF
}

die() { printf '错误：%s\n' "$*" >&2; exit 1; }
require_root() { [[ $(id -u) -eq 0 ]] || die "请使用 root 或 sudo 运行"; }

init_state() {
  install -d -m 0700 "$STATE_ROOT" "$SNAPSHOT_ROOT"
  if [[ ! -f $INCIDENT_FILE ]]; then
    printf 'ID\tUTC_TIME\tCODE\tFIRST_SEEN\tACTION\tRESULT\tDETAIL\n' >"$INCIDENT_FILE"
    chmod 0600 "$INCIDENT_FILE"
  fi
}

prune_transactions() {
  local -a snapshots=()
  local remove_count index
  shopt -s nullglob
  snapshots=("$SNAPSHOT_ROOT"/transaction-*)
  shopt -u nullglob
  if (( ${#snapshots[@]} >= 5 )); then
    remove_count=$((${#snapshots[@]} - 4))
    for ((index=0; index<remove_count; index++)); do
      rm -rf -- "${snapshots[index]}"
    done
  fi
}

wait_for_service_ready() {
  local port attempt
  port=$(awk -F= '$1 == "SOCKS_PORT" {print $2; exit}' "$CONFIG_DIR/node.env" 2>/dev/null || true)
  [[ $port =~ ^[0-9]+$ ]] || return 1
  command -v ss >/dev/null 2>&1 || return 1
  for ((attempt=1; attempt<=15; attempt++)); do
    if systemctl is-active --quiet "$SERVICE" \
       && ss -H -lnt | awk -v wanted=":$port" '$4 ~ wanted "$" {found=1} END {exit !found}'; then
      return 0
    fi
    (( attempt == 15 )) || sleep 1
  done
  return 1
}

safe_field() {
  printf '%s' "$1" | tr '\t\r\n' '   ' | cut -c1-160
}

record_incident() {
  local code=${1:-UNKNOWN} action=${2:-none} result=${3:-recorded} detail=${4:-unspecified}
  [[ $code =~ ^[A-Z0-9_-]{3,40}$ ]] || code=UNKNOWN
  init_state
  if command -v flock >/dev/null 2>&1; then
    exec 7>"$STATE_ROOT/incidents.lock"
    flock -w 5 7 || die "事件档案正在被另一个任务写入，请稍后重试"
  fi
  local fingerprint first_seen timestamp incident_id tool_version
  tool_version=$(awk -F= '$1 == "TOOL_VERSION" {print $2}' "$CONFIG_DIR/node.env" 2>/dev/null || true)
  [[ $tool_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || tool_version=unknown
  # 未知故障和人工备注要按具体内容区分，避免不同问题被误判为同一条记录。
  if [[ $code == *UNKNOWN* || $code == USER_OBSERVATION ]]; then
    fingerprint=$(printf '%s|%s' "$code" "$detail" | sha256sum | awk '{print substr($1,1,10)}')
  else
    fingerprint=$(printf '%s' "$code" | sha256sum | awk '{print substr($1,1,10)}')
  fi
  if awk -F '\t' -v code="$code" -v fp="$fingerprint" 'NR > 1 && $3 == code && $7 ~ ("fingerprint=" fp) {found=1} END {exit !found}' "$INCIDENT_FILE"; then
    first_seen=no
  else
    first_seen=yes
  fi
  timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  incident_id="INC-$(date -u +%Y%m%d-%H%M%S)-$fingerprint-${BASHPID:-$$}"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$incident_id" "$timestamp" "$code" "$first_seen" \
    "$(safe_field "$action")" "$(safe_field "$result")" \
    "$(safe_field "$detail");tool_version=$tool_version;fingerprint=$fingerprint" >>"$INCIDENT_FILE"
  if (( $(wc -l <"$INCIDENT_FILE") > 2001 )); then
    local trimmed="$STATE_ROOT/.incidents.trimmed.$$"
    { head -n 1 "$INCIDENT_FILE"; tail -n 2000 "$INCIDENT_FILE"; } >"$trimmed"
    chmod 0600 "$trimmed"
    mv -f "$trimmed" "$INCIDENT_FILE"
  fi
  printf '%s\n' "$incident_id"
}

copy_current_to() {
  local destination=$1 tool_name
  install -d -m 0700 "$destination"
  [[ -d $CONFIG_DIR ]] && cp -a "$CONFIG_DIR" "$destination/config"
  [[ -d $BINARY_DIR ]] && cp -a "$BINARY_DIR" "$destination/binary"
  [[ -f $SERVICE_FILE ]] && cp -a "$SERVICE_FILE" "$destination/gost-socks.service"
  install -d -m 0700 "$destination/tools"
  : >"$destination/tools-present"
  for tool_name in "${TOOL_NAMES[@]}"; do
    if [[ -f $TOOLS_DIR/$tool_name ]]; then
      cp -a "$TOOLS_DIR/$tool_name" "$destination/tools/$tool_name"
      printf '%s\n' "$tool_name" >>"$destination/tools-present"
    fi
  done
  chmod 0600 "$destination/tools-present"
  systemctl is-enabled "$SERVICE" >"$destination/enabled-state" 2>/dev/null || true
  systemctl is-active "$SERVICE" >"$destination/active-state" 2>/dev/null || true
  date -u +%Y-%m-%dT%H:%M:%SZ >"$destination/created-at"
  (
    cd "$destination"
    find . -type f ! -name MANIFEST.sha256 -print0 \
      | sort -z | xargs -0 sha256sum >MANIFEST.sha256
  )
  chmod 0600 "$destination/MANIFEST.sha256"
}

validate_snapshot() {
  local source=${1:-$SNAPSHOT_ROOT/last-good} env_file config_file port username password config_content
  local tool_name known_tool expected_tool
  [[ -d $source/config && -d $source/binary && -f $source/gost-socks.service \
     && -f $source/config/node.env && -f $source/config/gost.yaml \
     && -x $source/binary/gost ]] || die "快照结构不完整：$source"
  env_file="$source/config/node.env"
  config_file="$source/config/gost.yaml"
  port=$(awk -F= '$1 == "SOCKS_PORT" {print $2; exit}' "$env_file")
  username=$(awk -F= '$1 == "SOCKS_USERNAME" {print $2; exit}' "$env_file")
  password=$(awk -F= '$1 == "SOCKS_PASSWORD" {print $2; exit}' "$env_file")
  [[ $port =~ ^[0-9]+$ && $port -ge 1024 && $port -le 65535 \
     && $username =~ ^[A-Za-z0-9._-]{4,32}$ \
     && $password =~ ^[A-Za-z0-9._-]{16,64}$ ]] \
    || die "快照中的端口或凭据记录格式异常：$source"
  config_content=$(<"$config_file")
  [[ $config_content == *"addr: \":$port\""* \
     && $config_content == *"username: \"$username\""* \
     && $config_content == *"password: \"$password\""* ]] \
    || die "快照配置与凭据记录不一致：$source"
  grep -Fq 'ExecStart=' "$source/gost-socks.service" \
    || die "快照服务定义不完整：$source"
  if [[ -f $source/tools-present ]]; then
    while IFS= read -r tool_name; do
      [[ -n $tool_name ]] || continue
      known_tool=false
      for expected_tool in "${TOOL_NAMES[@]}"; do
        if [[ $tool_name == "$expected_tool" ]]; then
          known_tool=true
          break
        fi
      done
      [[ $known_tool == true && -f $source/tools/$tool_name ]] \
        || die "快照管理工具清单异常：$source"
    done <"$source/tools-present"
  fi
  if [[ -f $source/MANIFEST.sha256 ]]; then
    (cd "$source" && sha256sum -c MANIFEST.sha256 >/dev/null) \
      || die "快照校验值不匹配：$source"
    printf '快照校验通过：%s\n' "$source"
  else
    # v1.6.1 及更早快照没有清单；仅允许结构兼容检查，下一次成功升级会生成带校验值的新快照。
    printf '兼容检查通过（旧快照没有校验清单）：%s\n' "$source"
  fi
}

snapshot_transaction() {
  init_state
  prune_transactions
  [[ -d $CONFIG_DIR && -d $BINARY_DIR && -f $SERVICE_FILE ]] || exit 3
  local timestamp destination
  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  destination="$SNAPSHOT_ROOT/transaction-$timestamp-$$"
  copy_current_to "$destination"
  printf '%s\n' "$destination"
}

promote_current() {
  local previous_source=${1:-}
  init_state
  [[ -d $CONFIG_DIR && -d $BINARY_DIR && -f $SERVICE_FILE ]] \
    || die "当前安装不完整，不能标记为最后可用状态"
  local candidate="$SNAPSHOT_ROOT/.candidate-$$"
  rm -rf -- "$candidate"
  copy_current_to "$candidate"
  rm -rf -- "$SNAPSHOT_ROOT/previous-good"
  if [[ -d $SNAPSHOT_ROOT/last-good ]]; then
    mv "$SNAPSHOT_ROOT/last-good" "$SNAPSHOT_ROOT/previous-good"
  elif [[ -n $previous_source && -d $previous_source ]]; then
    cp -a "$previous_source" "$SNAPSHOT_ROOT/previous-good"
  fi
  mv "$candidate" "$SNAPSHOT_ROOT/last-good"
  if [[ -n $previous_source && -d $previous_source ]]; then
    rm -rf -- "$previous_source"
  fi
  printf '已保存最后可用状态。\n'
}

restore_snapshot() {
  local source=${1:-$SNAPSHOT_ROOT/last-good}
  init_state
  validate_snapshot "$source" >/dev/null
  local restore_id stage_config stage_binary stage_tools old_config old_binary old_service old_tools
  local config_parent binary_parent tool_name restore_tools=false preserve_legacy_bbrctl=false
  restore_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  config_parent=$(dirname "$CONFIG_DIR")
  binary_parent=$(dirname "$BINARY_DIR")
  stage_config=$(mktemp -d "$config_parent/.gost-socks.restore.XXXXXX")
  stage_binary=$(mktemp -d "$binary_parent/.gost-socks.restore.XXXXXX")
  cp -a "$source/config/." "$stage_config/"
  cp -a "$source/binary/." "$stage_binary/"
  chmod 0750 "$stage_config"
  chmod 0600 "$stage_config/node.env"
  chmod 0640 "$stage_config/gost.yaml"
  chmod 0755 "$stage_binary" "$stage_binary/gost"
  if [[ $CONFIG_DIR == /etc/gost-socks && $BINARY_DIR == /usr/local/lib/gost-socks ]]; then
    chown root:gost-socks "$stage_config" "$stage_config/gost.yaml"
    chown root:root "$stage_config/node.env" "$stage_binary" "$stage_binary/gost"
  fi
  old_config="$STATE_ROOT/.restore-old-config-$restore_id"
  old_binary="$STATE_ROOT/.restore-old-binary-$restore_id"
  old_service="$STATE_ROOT/.restore-old-service-$restore_id"
  old_tools="$STATE_ROOT/.restore-old-tools-$restore_id"
  [[ -f $SERVICE_FILE ]] && cp -a "$SERVICE_FILE" "$old_service"
  if [[ -f $source/tools-present ]]; then
    restore_tools=true
    if ! grep -Fxq bbrctl "$source/tools-present"; then
      preserve_legacy_bbrctl=true
    fi
    stage_tools=$(mktemp -d "$STATE_ROOT/.restore-tools.XXXXXX")
    install -d -m 0700 "$old_tools/tools"
    : >"$old_tools/tools-present"
    for tool_name in "${TOOL_NAMES[@]}"; do
      if [[ -f $TOOLS_DIR/$tool_name ]]; then
        cp -a "$TOOLS_DIR/$tool_name" "$old_tools/tools/$tool_name"
        printf '%s\n' "$tool_name" >>"$old_tools/tools-present"
      fi
      if grep -Fxq "$tool_name" "$source/tools-present"; then
        install -m 0755 "$source/tools/$tool_name" "$stage_tools/$tool_name"
      fi
    done
    chmod 0600 "$old_tools/tools-present"
  fi
  restore_failed() {
    local status=$?
    trap - ERR
    set +e
    systemctl stop "$SERVICE" >/dev/null 2>&1
    rm -rf -- "$CONFIG_DIR" "$BINARY_DIR"
    [[ -d $old_config ]] && mv "$old_config" "$CONFIG_DIR"
    [[ -d $old_binary ]] && mv "$old_binary" "$BINARY_DIR"
    [[ -f $old_service ]] && install -m 0644 "$old_service" "$SERVICE_FILE"
    if [[ $restore_tools == true ]]; then
      for tool_name in "${TOOL_NAMES[@]}"; do
        [[ $preserve_legacy_bbrctl == true && $tool_name == bbrctl ]] && continue
        rm -f -- "$TOOLS_DIR/$tool_name"
        if grep -Fxq "$tool_name" "$old_tools/tools-present" 2>/dev/null; then
          install -m 0755 "$old_tools/tools/$tool_name" "$TOOLS_DIR/$tool_name"
        fi
      done
    fi
    systemctl daemon-reload
    systemctl restart "$SERVICE" >/dev/null 2>&1
    rm -rf -- "$stage_config" "$stage_binary" "${stage_tools:-}" "$old_tools"
    printf '快照恢复失败，已尝试放回恢复前文件。\n' >&2
    exit "$status"
  }
  trap restore_failed ERR
  systemctl stop "$SERVICE" >/dev/null 2>&1 || true
  [[ -d $CONFIG_DIR ]] && mv "$CONFIG_DIR" "$old_config"
  [[ -d $BINARY_DIR ]] && mv "$BINARY_DIR" "$old_binary"
  mv "$stage_config" "$CONFIG_DIR"
  mv "$stage_binary" "$BINARY_DIR"
  install -m 0644 "$source/gost-socks.service" "$SERVICE_FILE"
  if [[ $restore_tools == true ]]; then
    install -d -m 0755 "$TOOLS_DIR"
    for tool_name in "${TOOL_NAMES[@]}"; do
      [[ $preserve_legacy_bbrctl == true && $tool_name == bbrctl ]] && continue
      if grep -Fxq "$tool_name" "$source/tools-present"; then
        install -m 0755 "$stage_tools/$tool_name" "$TOOLS_DIR/$tool_name"
      else
        rm -f -- "$TOOLS_DIR/$tool_name"
      fi
    done
  fi
  systemctl daemon-reload
  if [[ $(cat "$source/enabled-state" 2>/dev/null || true) == enabled ]]; then
    systemctl enable "$SERVICE" >/dev/null
  else
    systemctl disable "$SERVICE" >/dev/null 2>&1 || true
  fi
  if [[ $(cat "$source/active-state" 2>/dev/null || true) == active ]]; then
    systemctl restart "$SERVICE"
    if ! wait_for_service_ready; then
      printf '恢复后的服务未在 15 秒内监听原端口。\n' >&2
      false
    fi
  else
    systemctl stop "$SERVICE" >/dev/null 2>&1 || true
  fi
  trap - ERR
  rm -rf -- "$old_config" "$old_binary"
  rm -f -- "$old_service"
  rm -rf -- "${stage_tools:-}" "$old_tools"
  printf '已恢复快照：%s\n' "$source"
}

list_incidents() {
  local query=${1:-20}
  init_state
  if [[ $query == INC-* ]]; then
    awk -F '\t' -v id="$query" 'BEGIN {OFS=" | "} NR == 1 || $1 == id {print $1,$2,$3,$4,$5,$6,$7}' "$INCIDENT_FILE"
    awk -F '\t' -v id="$query" '$1 == id {found=1} END {exit !found}' "$INCIDENT_FILE" \
      || die "未找到事件：$query"
    return
  fi
  local lines=$query
  [[ $lines =~ ^[0-9]+$ && $lines -ge 1 && $lines -le 200 ]] \
    || die "记录数量必须是 1-200"
  { head -n 1 "$INCIDENT_FILE"; tail -n +2 "$INCIDENT_FILE" | tail -n "$lines"; } \
    | awk -F '\t' 'BEGIN {OFS=" | "} {print $1,$2,$3,$4,$5,$6,$7}'
}

list_snapshots() {
  init_state
  local name created version
  printf '快照 | 创建时间(UTC) | 工具版本\n'
  for name in last-good previous-good; do
    if [[ -d $SNAPSHOT_ROOT/$name ]]; then
      created=$(cat "$SNAPSHOT_ROOT/$name/created-at" 2>/dev/null || printf '未知')
      version=$(awk -F= '$1 == "TOOL_VERSION" {print $2}' \
        "$SNAPSHOT_ROOT/$name/config/node.env" 2>/dev/null || true)
      printf '%s | %s | %s\n' "$name" "$created" "${version:-legacy}"
    else
      printf '%s | 无 | 无\n' "$name"
    fi
  done
}

recovery_guard() {
  local fingerprint=${1:-}
  [[ $fingerprint =~ ^[A-Z0-9_,.-]{3,120}$ ]] || die "恢复指纹格式错误"
  init_state
  local guard_file="$STATE_ROOT/last-auto-recovery" previous_epoch previous_fingerprint now elapsed
  [[ -f $guard_file ]] || return 0
  read -r previous_epoch previous_fingerprint <"$guard_file" || return 0
  [[ $previous_epoch =~ ^[0-9]+$ ]] || return 0
  now=$(date +%s)
  elapsed=$((now - previous_epoch))
  if [[ $previous_fingerprint == "$fingerprint" && $elapsed -ge 0 && $elapsed -lt 1800 ]]; then
    printf '相同故障在最近 30 分钟已经自动恢复过一次，熔断器阻止再次恢复。\n' >&2
    return 4
  fi
}

recovery_mark() {
  local fingerprint=${1:-}
  [[ $fingerprint =~ ^[A-Z0-9_,.-]{3,120}$ ]] || die "恢复指纹格式错误"
  init_state
  printf '%s %s\n' "$(date +%s)" "$fingerprint" >"$STATE_ROOT/last-auto-recovery"
  chmod 0600 "$STATE_ROOT/last-auto-recovery"
}

command_name=${1:-help}
shift || true
if [[ $command_name == help || $command_name == --help || $command_name == -h ]]; then
  usage
  exit 0
fi
if [[ $STATE_ROOT == /var/lib/gost-socks-safety ]]; then
  require_root
fi
case "$command_name" in
  snapshot) [[ $# -eq 0 ]] || die "snapshot 不接受参数"; snapshot_transaction ;;
  promote) [[ $# -le 1 ]] || die "promote 参数过多"; promote_current "${1:-}" ;;
  verify) [[ $# -le 1 ]] || die "verify 参数过多"; validate_snapshot "${1:-$SNAPSHOT_ROOT/last-good}" ;;
  restore) [[ $# -le 1 ]] || die "restore 参数过多"; restore_snapshot "${1:-$SNAPSHOT_ROOT/last-good}" ;;
  incident) [[ $# -ge 1 && $# -le 4 ]] || die "incident 参数错误"; record_incident "$@" ;;
  incidents) [[ $# -le 1 ]] || die "incidents 参数过多"; list_incidents "${1:-20}" ;;
  snapshots) [[ $# -eq 0 ]] || die "snapshots 不接受参数"; list_snapshots ;;
  recovery-guard) [[ $# -eq 1 ]] || die "recovery-guard 需要故障指纹"; recovery_guard "$1" ;;
  recovery-mark) [[ $# -eq 1 ]] || die "recovery-mark 需要故障指纹"; recovery_mark "$1" ;;
  *) usage >&2; die "未知命令：$command_name" ;;
esac
