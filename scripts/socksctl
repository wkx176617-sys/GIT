#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_DIR="${SOCKSCTL_CONFIG_DIR:-/etc/gost-socks}"
readonly CONFIG_FILE="$CONFIG_DIR/gost.yaml"
readonly ENV_FILE="$CONFIG_DIR/node.env"
readonly SERVICE="gost-socks.service"
readonly BINARY="/usr/local/lib/gost-socks/gost"
readonly SAFETY="/usr/local/sbin/socks-safety"
readonly DOCTOR="/usr/local/sbin/socks-doctor"
readonly LOCK_FILE="/run/lock/gost-socks-main.lock"

usage() {
  cat <<'EOF'
用法：sudo socksctl <命令>

命令：
  status            查看服务状态
  check [URL]       检查监听端口和代理出口
  info              显示节点信息（密码打码）
  credentials       显示完整账号密码
  export [类型]     导出客户端连接信息：all、v2rayn、shadowrocket
  qr [类型]         在终端生成二维码：v2rayn、shadowrocket
  logs [行数]       查看日志，默认 100 行
  restart           重启服务
  rotate            自动生成新密码并重启
  version           查看 GOST 版本
  doctor [--local]  运行脱敏健康诊断，不自动修改
  heal              本地确定性故障时恢复最后可用状态
  recover [目标]    手工恢复：last（默认）或 previous
  incidents [数量] 查询最近故障记录，默认 20 条
  snapshots         查看最后可用和前一可用快照
  note              交互式记录暂时无法归类的现象
EOF
}

die() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ $(id -u) -eq 0 ]] || die "请使用 sudo 运行"
}

acquire_lock() {
  command -v flock >/dev/null 2>&1 || die "缺少 flock（util-linux）"
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "另一个安装、覆写或维修任务正在运行，请等待完成后重试"
}

load_env() {
  if [[ $CONFIG_DIR == /etc/gost-socks ]]; then
    require_root
  fi
  [[ -f $ENV_FILE ]] || die "未找到节点配置：$ENV_FILE"
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  PUBLIC_IP=${PUBLIC_IP:-}
  TOOL_VERSION=${TOOL_VERSION:-legacy}
}

save_env() {
  local temp_file
  temp_file=$(mktemp "$CONFIG_DIR/.node.env.XXXXXX")
  cat >"$temp_file" <<EOF
NODE_NAME=$NODE_NAME
PUBLIC_IP=$PUBLIC_IP
SOCKS_PORT=$SOCKS_PORT
SOCKS_USERNAME=$SOCKS_USERNAME
SOCKS_PASSWORD=$SOCKS_PASSWORD
TOOL_VERSION=$TOOL_VERSION
EOF
  chmod 0600 "$temp_file"
  mv -f "$temp_file" "$ENV_FILE"
}

resolve_public_ip() {
  if [[ $PUBLIC_IP =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    return
  fi
  if [[ $NODE_NAME =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    PUBLIC_IP=$NODE_NAME
    return
  fi
  PUBLIC_IP=$(curl -4 --fail --silent --show-error --max-time 10 \
    https://api.ipify.org 2>/dev/null || true)
  [[ $PUBLIC_IP =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] \
    || die "无法确定服务器公网 IPv4，请重新运行安装程序"
}

make_share_links() {
  resolve_public_ip
  local user_info
  user_info=$(printf '%s' "$SOCKS_USERNAME:$SOCKS_PASSWORD" | base64 | tr -d '=\n')
  user_info=${user_info//+/%2B}
  user_info=${user_info//\//%2F}
  V2RAYN_LINK="socks://${user_info}@${PUBLIC_IP}:${SOCKS_PORT}#${NODE_NAME}"
  SHADOWROCKET_LINK="socks5://${SOCKS_USERNAME}:${SOCKS_PASSWORD}@${PUBLIC_IP}:${SOCKS_PORT}#${NODE_NAME}"
  SHADOWROCKET_TEXT="${NODE_NAME}=socks5,${PUBLIC_IP},${SOCKS_PORT},${SOCKS_USERNAME},${SOCKS_PASSWORD}"
}

print_manual_fields() {
  resolve_public_ip
  printf '类型：SOCKS5\n服务器：%s\n端口：%s\n用户名：%s\n密码：%s\n节点名称：%s\n' \
    "$PUBLIC_IP" "$SOCKS_PORT" "$SOCKS_USERNAME" "$SOCKS_PASSWORD" "$NODE_NAME"
}

render_config() {
  local temp_file
  temp_file=$(mktemp "$CONFIG_DIR/.gost.yaml.XXXXXX")
  cat >"$temp_file" <<EOF
services:
  - name: "$NODE_NAME"
    addr: ":$SOCKS_PORT"
    handler:
      type: socks5
      auth:
        username: "$SOCKS_USERNAME"
        password: "$SOCKS_PASSWORD"
      metadata:
        notls: true
    listener:
      type: tcp
EOF
  chown root:gost-socks "$temp_file"
  chmod 0640 "$temp_file"
  mv -f "$temp_file" "$CONFIG_FILE"
}

command_name=${1:-help}
shift || true

case "$command_name" in
  status)
    require_root
    systemctl --no-pager --full status "$SERVICE"
    ;;
  check)
    load_env
    test_url=${1:-https://api.ipify.org}
    [[ $test_url == https://* ]] || die "测试 URL 必须使用 https://"
    systemctl is-active --quiet "$SERVICE" || die "服务未运行"
    if command -v ss >/dev/null 2>&1; then
      ss -lnt | awk -v port=":$SOCKS_PORT" '$4 ~ port "$" {found=1} END {exit !found}' \
        || die "未检测到 TCP 监听端口 $SOCKS_PORT"
    fi
    printf '服务状态：运行中\n监听端口：%s\n' "$SOCKS_PORT"
    printf '代理出口：'
    curl --fail --silent --show-error --max-time 20 \
      --socks5-hostname "127.0.0.1:$SOCKS_PORT" \
      --proxy-user "$SOCKS_USERNAME:$SOCKS_PASSWORD" \
      "$test_url"
    printf '\n基础检查通过。\n'
    ;;
  info)
    load_env
    resolve_public_ip
    service_state=$(systemctl is-active "$SERVICE" 2>/dev/null || true)
    printf '节点名称：%s\n服务器：%s\n端口：%s\n用户名：%s\n密码：********\n服务状态：%s\n' \
      "$NODE_NAME" "$PUBLIC_IP" "$SOCKS_PORT" "$SOCKS_USERNAME" "$service_state"
    ;;
  credentials)
    load_env
    print_manual_fields
    ;;
  export)
    load_env
    export_type=${1:-all}
    make_share_links
    case "$export_type" in
      all)
        print_manual_fields
        printf '\nv2rayN 导入链接：\n%s\n\nShadowrocket 导入链接：\n%s\n\nShadowrocket 文本配置：\n%s\n' \
          "$V2RAYN_LINK" "$SHADOWROCKET_LINK" "$SHADOWROCKET_TEXT"
        ;;
      v2rayn) printf '%s\n' "$V2RAYN_LINK" ;;
      shadowrocket)
        printf 'Shadowrocket 导入链接：\n%s\n\nShadowrocket 文本配置：\n%s\n' \
          "$SHADOWROCKET_LINK" "$SHADOWROCKET_TEXT"
        ;;
      *) die "导出类型只能是 all、v2rayn 或 shadowrocket" ;;
    esac
    printf '\n警告：以上内容包含完整密码，请勿发到群聊或公开 GitHub。\n' >&2
    ;;
  qr)
    load_env
    qr_type=${1:-shadowrocket}
    make_share_links
    command -v qrencode >/dev/null 2>&1 \
      || die "服务器未安装 qrencode；请执行 apt-get update && apt-get install -y qrencode"
    case "$qr_type" in
      v2rayn) qr_link=$V2RAYN_LINK ;;
      shadowrocket) qr_link=$SHADOWROCKET_LINK ;;
      *) die "二维码类型只能是 v2rayn 或 shadowrocket" ;;
    esac
    printf '请使用自己的设备扫描，二维码包含完整节点密码。\n'
    qrencode -t ANSIUTF8 "$qr_link"
    ;;
  logs)
    require_root
    lines=${1:-100}
    [[ $lines =~ ^[0-9]+$ ]] || die "日志行数必须是数字"
    journalctl -u "$SERVICE" -n "$lines" --no-pager
    ;;
  restart)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    if ! systemctl restart "$SERVICE" || ! systemctl is-active --quiet "$SERVICE"; then
      incident_id=$($SAFETY incident RESTART_FAILED restore pending service-restart-failed)
      if "$SAFETY" restore && "$DOCTOR" --local; then
        "$SAFETY" incident RESTART_RECOVERED restore success "parent-$incident_id" >/dev/null
        printf '服务重启失败，事件 %s 已记录，并已恢复最后可用状态。\n' "$incident_id"
        exit 0
      fi
      "$SAFETY" incident RESTART_RECOVERY_FAILED restore failed "parent-$incident_id" >/dev/null 2>&1 || true
      die "服务重启及自动恢复均失败；事件编号：$incident_id"
    fi
    printf '服务已重启。\n'
    ;;
  rotate)
    load_env
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    transaction_snapshot=$($SAFETY snapshot 2>/dev/null || true)
    rotate_rollback() {
      trap - ERR
      incident_id=$($SAFETY incident ROTATE_FAILED rollback attempted password-rotation-failed || true)
      if [[ -n $transaction_snapshot ]]; then
        $SAFETY restore "$transaction_snapshot" >/dev/null 2>&1 || true
      else
        $SAFETY restore >/dev/null 2>&1 || true
      fi
      printf '密码轮换失败，已记录事件 %s，并尝试恢复原状态。\n' "$incident_id" >&2
    }
    trap rotate_rollback ERR
    if command -v openssl >/dev/null 2>&1; then
      SOCKS_PASSWORD=$(openssl rand -hex 16)
    else
      SOCKS_PASSWORD=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    fi
    save_env
    render_config
    systemctl restart "$SERVICE"
    systemctl is-active --quiet "$SERVICE" || die "新密码生效后服务启动失败"
    "$DOCTOR" --local >/dev/null
    "$SAFETY" promote "$transaction_snapshot" >/dev/null
    trap - ERR
    printf '密码已更新：%s\n请立即更新比特浏览器并保存到密码管理器。\n' "$SOCKS_PASSWORD"
    ;;
  version)
    require_root
    "$BINARY" -V
    ;;
  doctor)
    require_root
    [[ -x $DOCTOR ]] || die "未安装诊断工具，请先升级主程序"
    exec "$DOCTOR" "$@"
    ;;
  incidents)
    require_root
    [[ -x $SAFETY ]] || die "未安装事件档案工具，请先升级主程序"
    [[ $# -le 1 ]] || die "incidents 只接受数量或事件编号"
    exec "$SAFETY" incidents "${1:-20}"
    ;;
  heal)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    if "$DOCTOR" --local; then
      printf '本地协议状态正常，无需维修。\n'
      exit 0
    fi
    incident_id=$($SAFETY incident HEAL_STARTED restore pending local-deterministic-failure)
    if "$SAFETY" restore && "$DOCTOR" --local; then
      "$SAFETY" incident HEAL_COMPLETE restore success "parent-$incident_id" >/dev/null
      printf '维修完成，事件编号：%s。已恢复最后可用状态。\n' "$incident_id"
    else
      "$SAFETY" incident HEAL_FAILED restore failed "parent-$incident_id" >/dev/null 2>&1 || true
      die "恢复尝试失败；事件编号：$incident_id，请查询日志并人工处理"
    fi
    ;;
  recover)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    recover_target=${1:-last}
    [[ $# -le 1 ]] || die "recover 只接受 last 或 previous"
    case "$recover_target" in
      last) snapshot_path=""; snapshot_label=last-good ;;
      previous) snapshot_path="/var/lib/gost-socks-safety/snapshots/previous-good"; snapshot_label=previous-good ;;
      *) die "recover 只接受 last 或 previous" ;;
    esac
    printf '将恢复 %s 快照，并中断当前连接。输入 RESTORE 确认：' "$snapshot_label"
    read -r answer
    [[ $answer == RESTORE ]] || { printf '已取消。\n'; exit 0; }
    incident_id=$($SAFETY incident MANUAL_RECOVERY restore pending "user-requested-$snapshot_label")
    if [[ -n $snapshot_path ]]; then
      "$SAFETY" restore "$snapshot_path"
    else
      "$SAFETY" restore
    fi
    "$DOCTOR" --local
    "$SAFETY" incident MANUAL_RECOVERY restore success "parent-$incident_id" >/dev/null
    printf '恢复完成，事件编号：%s。\n' "$incident_id"
    ;;
  snapshots)
    require_root
    [[ $# -eq 0 ]] || die "snapshots 不接受参数"
    [[ -x $SAFETY ]] || die "未安装快照工具，请先升级主程序"
    exec "$SAFETY" snapshots
    ;;
  note)
    require_root
    [[ $# -eq 0 ]] || die "note 不接受命令行描述，避免内容留在历史记录中"
    [[ -x $SAFETY ]] || die "未安装事件档案工具，请先升级主程序"
    printf '请简短描述现象（不要输入账号、密码或私钥）：'
    read -r observation
    [[ -n $observation ]] || die "描述不能为空"
    incident_id=$($SAFETY incident USER_OBSERVATION observe recorded "$observation")
    printf '已保存为事件 %s。可运行 socksctl incidents %s 查询。\n' "$incident_id" "$incident_id"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    die "未知命令：$command_name"
    ;;
esac
