#!/usr/bin/env bash
set -Eeuo pipefail

readonly CONFIG_DIR="${SOCKSCTL_CONFIG_DIR:-/etc/gost-socks}"
readonly CONFIG_FILE="$CONFIG_DIR/gost.yaml"
readonly ENV_FILE="$CONFIG_DIR/node.env"
readonly SERVICE="gost-socks.service"
readonly BINARY="/usr/local/lib/gost-socks/gost"
readonly SAFETY="${SOCKS_SAFETY_BIN:-/usr/local/sbin/socks-safety}"
readonly DOCTOR="${SOCKS_DOCTOR_BIN:-/usr/local/sbin/socks-doctor}"
readonly REFRESH_IP="${SOCKS_REFRESH_IP_BIN:-/usr/local/sbin/socks-refresh-ip}"
readonly UPGRADE="${SOCKS_UPGRADE_BIN:-/usr/local/sbin/socks-upgrade}"
readonly LOCK_FILE="${SOCKS_LOCK_FILE:-/run/lock/gost-socks-main.lock}"

usage() {
  cat <<'EOF'
用法：sudo socksctl <命令>

命令：
  status            查看服务状态
  check [URL]       检查监听端口和代理出口
  info              显示节点信息（密码打码）
  credentials       显示完整账号密码
  export [类型]     导出客户端连接信息：all、v2rayn、shadowrocket
  qr [类型]         在终端生成二维码：v2rayn、shadowrocket
  refresh-ip        VPS更换公网IP后安全更新节点记录和导入信息
  upgrade latest|vX.Y.Z  一条命令切换稳定版本；旧版需健康快照
  logs [行数]       查看日志，默认 100 行
  restart           重启服务
  rotate            自动生成新密码并重启
  version           查看项目工具和 GOST 核心版本
  doctor [--local]  运行脱敏健康诊断，不自动修改
  heal              本地确定性故障时恢复最后可用状态
  recover [目标]    手工恢复：last（默认）或 previous
  incidents [数量] 查询最近故障记录，默认 20 条
  snapshots         查看最后可用和前一可用快照
  note              交互式记录暂时无法归类的现象
  report            生成可交给 Codex 的脱敏故障报告
  reports           查看服务器上的脱敏报告
  report-delete     确认后删除服务器上的全部脱敏报告
  guide             中文新手菜单（推荐）
EOF
}

die() {
  printf '错误：%s\n' "$*" >&2
  exit 1
}

require_root() {
  [[ $(id -u) -eq 0 ]] || die "请使用 sudo 运行"
}

acquire_lock() {
  command -v flock >/dev/null 2>&1 || die "缺少 flock（util-linux）"
  exec 9>"$LOCK_FILE"
  flock -n 9 || die "另一个安装、覆写或维修任务正在运行，请等待完成后重试"
}

load_env() {
  if [[ $CONFIG_DIR == /etc/gost-socks ]]; then
    require_root
  fi
  [[ -f $ENV_FILE ]] || die "未找到节点配置：$ENV_FILE"
  NODE_NAME=$(awk -F= '$1 == "NODE_NAME" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  PUBLIC_IP=$(awk -F= '$1 == "PUBLIC_IP" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  SOCKS_PORT=$(awk -F= '$1 == "SOCKS_PORT" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  SOCKS_USERNAME=$(awk -F= '$1 == "SOCKS_USERNAME" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  SOCKS_PASSWORD=$(awk -F= '$1 == "SOCKS_PASSWORD" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  TOOL_VERSION=$(awk -F= '$1 == "TOOL_VERSION" {sub(/^[^=]*=/, ""); print; exit}' "$ENV_FILE")
  PUBLIC_IP=${PUBLIC_IP:-}
  TOOL_VERSION=${TOOL_VERSION:-legacy}
  [[ $NODE_NAME =~ ^[A-Za-z0-9._-]{2,32}$ \
     && $SOCKS_PORT =~ ^[0-9]+$ && $SOCKS_PORT -ge 1024 && $SOCKS_PORT -le 65535 \
     && $SOCKS_USERNAME =~ ^[A-Za-z0-9._-]{4,32}$ \
     && $SOCKS_PASSWORD =~ ^[A-Za-z0-9._-]{16,64}$ ]] \
    || die "节点记录格式异常。没有执行操作；请运行 socksctl doctor --no-record"
}

save_env() {
  local temp_file
  temp_file=$(mktemp "$CONFIG_DIR/.node.env.XXXXXX")
  cat >"$temp_file" <<EOF
NODE_NAME=$NODE_NAME
PUBLIC_IP=$PUBLIC_IP
SOCKS_PORT=$SOCKS_PORT
SOCKS_USERNAME=$SOCKS_USERNAME
SOCKS_PASSWORD=$SOCKS_PASSWORD
TOOL_VERSION=$TOOL_VERSION
EOF
  chmod 0600 "$temp_file"
  mv -f "$temp_file" "$ENV_FILE"
}

resolve_public_ip() {
  if [[ $PUBLIC_IP =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    return
  fi
  if [[ $NODE_NAME =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    PUBLIC_IP=$NODE_NAME
    return
  fi
  PUBLIC_IP=$(curl -4 --fail --silent --show-error --max-time 10 \
    https://api.ipify.org 2>/dev/null || true)
  [[ $PUBLIC_IP =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] \
    || die "无法确定服务器公网 IPv4，请重新运行安装程序"
}

make_share_links() {
  resolve_public_ip
  local user_info
  user_info=$(printf '%s' "$SOCKS_USERNAME:$SOCKS_PASSWORD" | base64 | tr -d '=\n')
  user_info=${user_info//+/%2B}
  user_info=${user_info//\//%2F}
  V2RAYN_LINK="socks://${user_info}@${PUBLIC_IP}:${SOCKS_PORT}#${NODE_NAME}"
  SHADOWROCKET_LINK="socks5://${SOCKS_USERNAME}:${SOCKS_PASSWORD}@${PUBLIC_IP}:${SOCKS_PORT}#${NODE_NAME}"
  SHADOWROCKET_TEXT="${NODE_NAME}=socks5,${PUBLIC_IP},${SOCKS_PORT},${SOCKS_USERNAME},${SOCKS_PASSWORD}"
}

print_manual_fields() {
  resolve_public_ip
  printf '类型：SOCKS5\n服务器：%s\n端口：%s\n用户名：%s\n密码：%s\n节点名称：%s\n' \
    "$PUBLIC_IP" "$SOCKS_PORT" "$SOCKS_USERNAME" "$SOCKS_PASSWORD" "$NODE_NAME"
}

render_config() {
  local temp_file
  temp_file=$(mktemp "$CONFIG_DIR/.gost.yaml.XXXXXX")
  cat >"$temp_file" <<EOF
services:
  - name: "$NODE_NAME"
    addr: ":$SOCKS_PORT"
    handler:
      type: socks5
      auth:
        username: "$SOCKS_USERNAME"
        password: "$SOCKS_PASSWORD"
      metadata:
        notls: true
    listener:
      type: tcp
EOF
  chown root:gost-socks "$temp_file"
  chmod 0640 "$temp_file"
  mv -f "$temp_file" "$CONFIG_FILE"
}

command_name=${1:-help}
shift || true

case "$command_name" in
  status)
    require_root
    systemctl --no-pager --full status "$SERVICE"
    ;;
  check)
    load_env
    test_url=${1:-https://api.ipify.org}
    [[ $test_url == https://* ]] || die "测试 URL 必须使用 https://"
    systemctl is-active --quiet "$SERVICE" || die "服务未运行"
    if command -v ss >/dev/null 2>&1; then
      ss -lnt | awk -v port=":$SOCKS_PORT" '$4 ~ port "$" {found=1} END {exit !found}' \
        || die "未检测到 TCP 监听端口 $SOCKS_PORT"
    fi
    printf '服务状态：运行中\n监听端口：%s\n' "$SOCKS_PORT"
    printf '代理出口：'
    curl --fail --silent --show-error --max-time 20 \
      --socks5-hostname "127.0.0.1:$SOCKS_PORT" \
      --proxy-user "$SOCKS_USERNAME:$SOCKS_PASSWORD" \
      "$test_url"
    printf '\n基础检查通过。\n'
    ;;
  info)
    load_env
    resolve_public_ip
    service_state=$(systemctl is-active "$SERVICE" 2>/dev/null || true)
    printf '节点名称：%s\n服务器：%s\n端口：%s\n用户名：%s\n密码：********\n服务状态：%s\n' \
      "$NODE_NAME" "$PUBLIC_IP" "$SOCKS_PORT" "$SOCKS_USERNAME" "$service_state"
    ;;
  credentials)
    load_env
    print_manual_fields
    ;;
  export)
    load_env
    export_type=${1:-all}
    make_share_links
    case "$export_type" in
      all)
        print_manual_fields
        printf '\nv2rayN 导入链接：\n%s\n\nShadowrocket 导入链接：\n%s\n\nShadowrocket 文本配置：\n%s\n' \
          "$V2RAYN_LINK" "$SHADOWROCKET_LINK" "$SHADOWROCKET_TEXT"
        ;;
      v2rayn) printf '%s\n' "$V2RAYN_LINK" ;;
      shadowrocket)
        printf 'Shadowrocket 导入链接：\n%s\n\nShadowrocket 文本配置：\n%s\n' \
          "$SHADOWROCKET_LINK" "$SHADOWROCKET_TEXT"
        ;;
      *) die "导出类型只能是 all、v2rayn 或 shadowrocket" ;;
    esac
    printf '\n警告：以上内容包含完整密码，请勿发到群聊或公开 GitHub。\n' >&2
    ;;
  qr)
    load_env
    qr_type=${1:-shadowrocket}
    make_share_links
    command -v qrencode >/dev/null 2>&1 \
      || die "二维码组件 qrencode 已被删除；请执行 apt-get update && apt-get install -y qrencode"
    case "$qr_type" in
      v2rayn) qr_link=$V2RAYN_LINK ;;
      shadowrocket) qr_link=$SHADOWROCKET_LINK ;;
      *) die "二维码类型只能是 v2rayn 或 shadowrocket" ;;
    esac
    printf '请使用自己的设备扫描，二维码包含完整节点密码。\n'
    qrencode -t ANSIUTF8 "$qr_link"
    ;;
  refresh-ip)
    require_root
    [[ -x $REFRESH_IP ]] || die "未安装公网IP更新模块，请先升级主程序"
    exec "$REFRESH_IP" "$@"
    ;;
  upgrade)
    require_root
    [[ -x $UPGRADE ]] || die "尚未安装安全版本切换模块，请按版本切换教程先引入一次"
    exec "$UPGRADE" "$@"
    ;;
  logs)
    require_root
    lines=${1:-100}
    [[ $lines =~ ^[0-9]+$ ]] || die "日志行数必须是数字"
    journalctl -u "$SERVICE" -n "$lines" --no-pager
    ;;
  restart)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    if ! systemctl restart "$SERVICE" || ! systemctl is-active --quiet "$SERVICE"; then
      incident_id=$($SAFETY incident RESTART_FAILED stopped needs-review service-restart-failed)
      printf '服务重启失败，但原因尚未确定，因此没有自动恢复或覆写配置。\n' >&2
      printf '事件编号：%s。请运行 socksctl report，并按照手动维修教程检查。\n' "$incident_id" >&2
      exit 1
    fi
    printf '服务已重启。\n'
    ;;
  rotate)
    load_env
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    transaction_snapshot=$($SAFETY snapshot 2>/dev/null || true)
    rotate_rollback() {
      trap - ERR
      incident_id=$($SAFETY incident ROTATE_FAILED rollback attempted password-rotation-failed || true)
      if [[ -n $transaction_snapshot ]]; then
        $SAFETY restore "$transaction_snapshot" >/dev/null 2>&1 || true
      else
        $SAFETY restore >/dev/null 2>&1 || true
      fi
      printf '密码轮换失败，已记录事件 %s，并尝试恢复原状态。\n' "$incident_id" >&2
    }
    trap rotate_rollback ERR
    if command -v openssl >/dev/null 2>&1; then
      SOCKS_PASSWORD=$(openssl rand -hex 16)
    else
      SOCKS_PASSWORD=$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')
    fi
    save_env
    render_config
    systemctl restart "$SERVICE"
    systemctl is-active --quiet "$SERVICE" || die "新密码生效后服务启动失败"
    "$DOCTOR" --local >/dev/null
    "$SAFETY" promote "$transaction_snapshot" >/dev/null
    trap - ERR
    printf '密码已更新：%s\n请立即更新比特浏览器并保存到密码管理器。\n' "$SOCKS_PASSWORD"
    ;;
  version)
    load_env
    printf '项目工具版本：%s\n' "${TOOL_VERSION/#legacy/早期版本（未记录版本号）}"
    printf 'GOST 核心版本：\n'
    "$BINARY" -V
    ;;
  doctor)
    require_root
    [[ -x $DOCTOR ]] || die "未安装诊断工具，请先升级主程序"
    exec "$DOCTOR" "$@"
    ;;
  incidents)
    require_root
    [[ -x $SAFETY ]] || die "未安装事件档案工具，请先升级主程序"
    [[ $# -le 1 ]] || die "incidents 只接受数量或事件编号"
    exec "$SAFETY" incidents "${1:-20}"
    ;;
  heal)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    doctor_status=0
    doctor_output=$("$DOCTOR" --local 2>&1) || doctor_status=$?
    printf '%s\n' "$doctor_output"
    if [[ $doctor_status -eq 0 ]]; then
      printf '本地协议状态正常，无需维修。\n'
      exit 0
    fi

    failure_codes=$(printf '%s\n' "$doctor_output" \
      | sed -n 's/^故障 \[\([^]]*\)\].*/\1/p' | sort -u | paste -sd, -)
    repairable_root=false
    blocked_code=""
    IFS=, read -r -a detected_codes <<<"$failure_codes"
    for detected_code in "${detected_codes[@]}"; do
      case "$detected_code" in
        CONFIG_MISSING|CONFIG_PERMISSION|CONFIG_MISMATCH) repairable_root=true ;;
        SERVICE_DOWN|PORT_NOT_LISTENING) ;;
        "") blocked_code=UNCLASSIFIED ;;
        *) blocked_code=$detected_code ;;
      esac
    done
    if [[ -z $failure_codes || $repairable_root != true || -n $blocked_code ]]; then
      incident_id=$($SAFETY incident HEAL_BLOCKED_UNCERTAIN stopped needs-review \
        "codes-${failure_codes:-unclassified}")
      printf '\n自动维修已停止：检测结果不在安全白名单内，或没有足够证据确认原因。\n' >&2
      printf '当前协议配置未被覆写。事件编号：%s。\n' "$incident_id" >&2
      printf '下一步：运行 socksctl report，并把报告内容和实际现象一起提供给 Codex。\n' >&2
      exit 2
    fi

    if ! "$SAFETY" recovery-guard "$failure_codes"; then
      incident_id=$($SAFETY incident RECOVERY_LOOP stopped needs-review "codes-$failure_codes")
      printf '自动维修已熔断：相同问题在 30 分钟内已经恢复过一次，不再重复修改。\n' >&2
      printf '当前状态保持不变。事件编号：%s。请运行 socksctl report。\n' "$incident_id" >&2
      exit 2
    fi
    incident_id=$($SAFETY incident HEAL_STARTED restore pending "whitelisted-$failure_codes")
    if "$SAFETY" restore && "$DOCTOR" --local; then
      "$SAFETY" recovery-mark "$failure_codes"
      "$SAFETY" incident HEAL_COMPLETE restore success "parent-$incident_id" >/dev/null
      printf '维修完成，事件编号：%s。已恢复最后可用状态。\n' "$incident_id"
    else
      "$SAFETY" incident HEAL_FAILED restore failed "parent-$incident_id" >/dev/null 2>&1 || true
      die "恢复尝试失败；事件编号：$incident_id，请查询日志并人工处理"
    fi
    ;;
  recover)
    require_root
    acquire_lock
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    recover_target=${1:-last}
    [[ $# -le 1 ]] || die "recover 只接受 last 或 previous"
    case "$recover_target" in
      last) snapshot_path=""; snapshot_label=last-good ;;
      previous) snapshot_path="/var/lib/gost-socks-safety/snapshots/previous-good"; snapshot_label=previous-good ;;
      *) die "recover 只接受 last 或 previous" ;;
    esac
    printf '将恢复 %s 快照，并中断当前连接。输入 RESTORE 确认：' "$snapshot_label"
    read -r answer
    [[ $answer == RESTORE ]] || { printf '已取消。\n'; exit 0; }
    incident_id=$($SAFETY incident MANUAL_RECOVERY restore pending "user-requested-$snapshot_label")
    if [[ -n $snapshot_path ]]; then
      "$SAFETY" restore "$snapshot_path"
    else
      "$SAFETY" restore
    fi
    "$DOCTOR" --local
    "$SAFETY" incident MANUAL_RECOVERY restore success "parent-$incident_id" >/dev/null
    printf '恢复完成，事件编号：%s。\n' "$incident_id"
    ;;
  snapshots)
    require_root
    [[ $# -eq 0 ]] || die "snapshots 不接受参数"
    [[ -x $SAFETY ]] || die "未安装快照工具，请先升级主程序"
    exec "$SAFETY" snapshots
    ;;
  note)
    require_root
    [[ $# -eq 0 ]] || die "note 不接受命令行描述，避免内容留在历史记录中"
    [[ -x $SAFETY ]] || die "未安装事件档案工具，请先升级主程序"
    printf '请简短描述现象（不要输入账号、密码或私钥）：'
    read -r observation
    [[ -n $observation ]] || die "描述不能为空"
    incident_id=$($SAFETY incident USER_OBSERVATION observe recorded "$observation")
    printf '已保存为事件 %s。可运行 socksctl incidents %s 查询。\n' "$incident_id" "$incident_id"
    ;;
  report)
    require_root
    [[ $# -eq 0 ]] || die "report 不接受参数"
    [[ -x $SAFETY && -x $DOCTOR ]] || die "安全组件不完整，请先升级主程序"
    umask 077
    report_env_value() {
      local key=$1
      awk -F= -v wanted="$key" '$1 == wanted {sub(/^[^=]*=/, ""); print; exit}' \
        "$ENV_FILE" 2>/dev/null || true
    }
    report_node_name=$(report_env_value NODE_NAME)
    report_public_ip=$(report_env_value PUBLIC_IP)
    report_port=$(report_env_value SOCKS_PORT)
    report_username=$(report_env_value SOCKS_USERNAME)
    report_password=$(report_env_value SOCKS_PASSWORD)
    report_tool_version=$(report_env_value TOOL_VERSION)
    [[ $report_node_name =~ ^[A-Za-z0-9._-]{2,32}$ ]] || report_node_name=unknown
    [[ $report_public_ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] || report_public_ip=""
    [[ $report_port =~ ^[0-9]+$ ]] || report_port=unknown
    [[ $report_tool_version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || report_tool_version=unknown
    [[ $report_username =~ ^[A-Za-z0-9._-]{4,32}$ ]] \
      || report_username=__NO_VALID_USERNAME_TO_REDACT__
    [[ $report_password =~ ^[A-Za-z0-9._-]{16,64}$ ]] \
      || report_password=__NO_VALID_PASSWORD_TO_REDACT__
    report_time=$(date -u +%Y%m%dT%H%M%SZ)
    raw_report=$(mktemp "/root/.gost-socks-report.${report_time}.XXXXXX")
    report_file="/root/gost-socks-report-${report_time}-${BASHPID:-$$}.txt"
    cleanup_report() { rm -f -- "${raw_report:-}"; }
    trap cleanup_report EXIT
    chmod 0600 "$raw_report"
    doctor_status=0
    doctor_output=$("$DOCTOR" --no-record 2>&1) || doctor_status=$?
    {
      printf '=== GOST SOCKS5 脱敏故障报告 ===\n'
      printf '生成时间(UTC)：%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      printf '工具版本：%s\n' "${report_tool_version:-unknown}"
      printf '节点：%s:%s\n' "${report_public_ip:-${report_node_name:-unknown}}" "$report_port"
      printf '诊断退出状态：%s\n\n' "$doctor_status"
      printf '%s\n' '--- 系统 ---'
      awk -F= '$1 == "PRETTY_NAME" {gsub(/"/, "", $2); print "系统：" $2}' /etc/os-release 2>/dev/null || true
      printf '内核：%s\n' "$(uname -srmo 2>/dev/null || true)"
      printf '运行时间：%s\n' "$(uptime -p 2>/dev/null || true)"
      df -h / 2>/dev/null || true
      free -h 2>/dev/null || true
      printf '\n%s\n' '--- 服务摘要 ---'
      systemctl show "$SERVICE" -p ActiveState -p SubState -p Result -p NRestarts -p ExecMainStatus 2>/dev/null || true
      if [[ $report_port != unknown ]]; then
        ss -H -lntp 2>/dev/null | awk -v port=":$report_port" '$4 ~ port "$" {print}' || true
      fi
      printf '\n%s\n%s\n' '--- 健康诊断 ---' "$doctor_output"
      printf '\n%s\n' '--- 健康快照 ---'
      "$SAFETY" snapshots 2>&1 || true
      printf '\n%s\n' '--- 最近 50 条事件 ---'
      "$SAFETY" incidents 50 2>&1 || true
      printf '\n%s\n' '--- GOST 最近 80 行日志 ---'
      journalctl -u "$SERVICE" -n 80 --no-pager 2>&1 || true
      printf '\n说明：报告不会读取 SSH 私钥，也不会主动写出 SOCKS5 密码；发送前仍请人工检查。\n'
    } >"$raw_report"
    escaped_password=${report_password//./\\.}
    escaped_username=${report_username//./\\.}
    sed -e "s/$escaped_password/[REDACTED_PASSWORD]/g" \
        -e "s/$escaped_username/[REDACTED_USER]/g" \
        "$raw_report" >"$report_file"
    chmod 0600 "$report_file"
    rm -f -- "$raw_report"
    trap - EXIT
    shopt -s nullglob
    report_files=(/root/gost-socks-report-*.txt)
    shopt -u nullglob
    if (( ${#report_files[@]} > 5 )); then
      remove_count=$((${#report_files[@]} - 5))
      for ((report_index=0; report_index<remove_count; report_index++)); do
        rm -f -- "${report_files[report_index]}"
      done
      printf '已自动删除 %s 份最旧报告，仅保留最近 5 份。\n' "$remove_count"
    fi
    printf '脱敏报告已生成：%s\n' "$report_file"
    printf '先运行 cat %s 人工检查，再把从标题到结尾的完整内容提供给 Codex。\n' "$report_file"
    ;;
  reports)
    require_root
    [[ $# -eq 0 ]] || die "reports 不接受参数"
    shopt -s nullglob
    report_files=(/root/gost-socks-report-*.txt)
    shopt -u nullglob
    if (( ${#report_files[@]} == 0 )); then
      printf '服务器上没有脱敏报告。\n'
    else
      printf '服务器上的脱敏报告（最多自动保留最近 5 份）：\n'
      for report_path in "${report_files[@]}"; do
        printf '%s\n' "$report_path"
      done
    fi
    ;;
  report-delete)
    require_root
    [[ $# -eq 0 ]] || die "report-delete 不接受参数"
    [[ -t 0 ]] || die "删除报告必须在交互式 SSH/Xshell 窗口中确认"
    shopt -s nullglob
    report_files=(/root/gost-socks-report-*.txt)
    shopt -u nullglob
    (( ${#report_files[@]} > 0 )) || { printf '没有报告需要删除。\n'; exit 0; }
    printf '将删除服务器上的 %s 份脱敏报告。输入 DELETE-REPORTS 确认：' "${#report_files[@]}"
    read -r delete_answer
    [[ $delete_answer == DELETE-REPORTS ]] || { printf '已取消。\n'; exit 0; }
    for report_path in "${report_files[@]}"; do
      rm -f -- "$report_path"
    done
    printf '脱敏报告已删除，无法从本工具恢复。\n'
    ;;
  guide)
    require_root
    [[ $# -eq 0 ]] || die "guide 不接受参数"
    [[ -t 0 ]] || die "新手菜单需要在交互式 SSH/Xshell 窗口中使用"
    cat <<'EOF'

SOCKS5 中文新手菜单
  1. 只读检查（推荐先运行，不写事件档案）
  2. 记录问题现象
  3. 生成给 Codex 的脱敏报告
  4. 查看最近故障记录
  5. 查看健康快照
  6. 尝试白名单自动维修
  7. 手工恢复最后可用状态（有二次确认）
  8. 查看节点信息（密码打码）
  9. VPS更换公网IP后更新节点记录
  10. 查询本项目工具版本（切换版本请看安全版本切换专题）
  0. 退出，不做任何操作
EOF
    printf '请输入一个数字后按回车：'
    read -r guide_choice
    case "$guide_choice" in
      1) exec "$0" doctor --no-record ;;
      2) exec "$0" note ;;
      3) exec "$0" report ;;
      4) exec "$0" incidents ;;
      5) exec "$0" snapshots ;;
      6) exec "$0" heal ;;
      7) exec "$0" recover ;;
      8) exec "$0" info ;;
      9) exec "$0" refresh-ip ;;
      10)
        [[ -x $UPGRADE ]] || die "尚未安装安全版本切换模块，请按版本切换教程先引入一次"
        exec "$UPGRADE" --current
        ;;
      0) printf '已退出，没有修改任何内容。\n' ;;
      *) die "输入无效，没有执行任何操作；请重新运行 socksctl guide" ;;
    esac
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    usage >&2
    die "未知命令：$command_name"
    ;;
esac
